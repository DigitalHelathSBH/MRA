# SQL Server (ทุก DB อยู่บน server เดียวกัน)
DB_SERVER=10.0.1.1
DB_PORT=1433
DB_USER=
DB_PASSWORD=
# DB ที่เก็บ schema mra.* และตาราง mra_ipd_main / mra_ipd (ทดสอบใช้ MRA_TEST, ใช้งานจริงใช้ MRA)
DB_NAME=MRA_TEST
# DB ของ HIS และ intranet (อ่านอย่างเดียว)
DB_HIS=SSBDatabase
DB_INTRANET=saraburi

# สุ่มอย่างน้อย 32 ตัวอักษร ใช้เข้ารหัส cookie session
SESSION_PASSWORD=

# production: true (ค่าเริ่มต้น) ต้องเข้าผ่าน HTTPS · ตั้ง false ได้ชั่วคราวถ้ายังไม่มีใบรับรอง
COOKIE_SECURE=true

# เวชระเบียนสแกน (PDF) แสดงด้านซ้ายของหน้าแบบตรวจ · {an} จะถูกแทนด้วย AN · ไม่ตั้ง = แสดงข้อความแจ้ง
CHART_PDF_URL=http://10.0.255.111/chart/{an}.pdf
